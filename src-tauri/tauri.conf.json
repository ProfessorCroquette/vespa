{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vespa",
  "version": "0.1.0",
  "identifier": "com.win11.vespa",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "vespa",
        "width": 800,
        "height": 600,
        "minWidth": 340,
        "minHeight": 62,
        "decorations": false,
        "transparent": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$TEMP/vespa-artwork/**",
          "$HOME/Music/**",
          "$HOME/Downloads/**",
          "I:/**",
          "E:/**",
          "C:/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}